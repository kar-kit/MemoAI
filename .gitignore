# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# macOS
.DS_Store
*.pem

# environment variables (all sub-projects)
.env
.env.*
!.env.example


# ─── rest-backend ────────────────────────────────────────────────────────────

# Python cache
rest-backend/**/__pycache__/
rest-backend/**/*.py[cod]
rest-backend/**/*.pyo

# virtual environments
rest-backend/.venv/
rest-backend/venv/
rest-backend/env/

# dependency lock (regenerated on deploy)
rest-backend/Pipfile.lock

# test / coverage artifacts
rest-backend/.coverage
rest-backend/.coverage.*
rest-backend/coverage.xml
rest-backend/htmlcov/
rest-backend/allure-results/
rest-backend/report.html
rest-backend/.pytest_cache/

# logs
rest-backend/*.log


# ─── mobile-frontend ─────────────────────────────────────────────────────────

# dependencies
mobile-frontend/node_modules/
mobile-frontend/package-lock.json

# Expo
mobile-frontend/.expo/
mobile-frontend/dist/
mobile-frontend/web-build/
mobile-frontend/expo-env.d.ts

# Native
mobile-frontend/.kotlin/
mobile-frontend/*.orig.*
mobile-frontend/*.jks
mobile-frontend/*.p8
mobile-frontend/*.p12
mobile-frontend/*.key
mobile-frontend/*.mobileprovision

# Metro
mobile-frontend/.metro-health-check*

# debug
mobile-frontend/npm-debug.*
mobile-frontend/yarn-debug.*
mobile-frontend/yarn-error.*

# local env files
mobile-frontend/.env*.local

# typescript
mobile-frontend/*.tsbuildinfo

# generated native folders
mobile-frontend/ios
mobile-frontend/android
mobile-frontend/app-example


# ─── analytics-dashboard ─────────────────────────────────────────────────────

analytics-dashboard/node_modules
analytics-dashboard/.next/
analytics-dashboard/.env.local


# ─── web-frontend ────────────────────────────────────────────────────────────

# dependencies
web-frontend/node_modules
web-frontend/package-lock.json
web-frontend/.pnp
web-frontend/.pnp.*
web-frontend/.yarn/*
web-frontend/!.yarn/patches
web-frontend/!.yarn/plugins
web-frontend/!.yarn/releases
web-frontend/!.yarn/versions

# next.js build output
web-frontend/.next/
web-frontend/out/
web-frontend/build

# testing
web-frontend/coverage

# debug
web-frontend/npm-debug.log*
web-frontend/yarn-debug.log*
web-frontend/yarn-error.log*
web-frontend/.pnpm-debug.log*

# vercel
web-frontend/.vercel

# typescript
web-frontend/*.tsbuildinfo
web-frontend/next-env.d.ts
